# Get this from https://huggingface.co/settings/tokens (a "Read" token is enough)
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model available via Hugging Face Inference Providers
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Shown in the bot's persona / system prompt
COMPANY_NAME=Your Company Name

# Local dev port only (Vercel ignores this)
PORT=5000
